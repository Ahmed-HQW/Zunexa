{
  "version": 2,
  "name": "zunexa-archon",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
   { "source": "/ai",        "destination": "/ai.html" },
    { "source": "/app",       "destination": "/ai.html" },
    { "source": "/dashboard", "destination": "/ai.html" },
    { "source": "/home",      "destination": "/landing.html" },
    { "source": "/owner_admin", "destination": "/owner_admin.html" },
    ],
  "redirects": [
    { "source": "/admin",     "destination": "/owner_admin", "permanent": false },
    { "source": "/contact",   "destination": "/CONTACT",     "permanent": true  },
    { "source": "/affiliate", "destination": "/affiliat",    "permanent": true  }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://*.supabase.co https://pagead2.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https: https://*.supabase.co https://text.pollinations.ai https://accounts.google.com https://github.com; form-action 'self' https://*.supabase.co https://accounts.google.com https://github.com; frame-src 'self' https://accounts.google.com; worker-src 'self' blob: https://cdnjs.cloudflare.com; frame-ancestors 'none';"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/theme.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
     "source": "/zunexa_qa.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=600" }
      ]
    },
    {
      "source": "/zunexa_free_templates.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=600" }
      ]
    }
  ]
}
