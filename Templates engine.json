/**
 * Zunexa Free-Mode Template Engine
 * --------------------------------
 * Consumes zunexa_free_templates.json and turns it into a combinatorial,
 * anti-repetition, niche-aware content generator for Free-plan users
 * (no paid AI provider call needed).
 *
 * USAGE (browser / dashboard):
 *   const engine = new ZunexaTemplateEngine();
 *   await engine.load("./zunexa_free_templates.json");
 *   const post = engine.generatePost({ topic: "coaching ديال الصحة", lang: "darija" });
 *   console.log(post.text);
 *
 * USAGE (Node / server):
 *   const engine = new ZunexaTemplateEngine();
 *   await engine.loadFromObject(require("./zunexa_free_templates.json"));
 *   const post = engine.generatePost({ topic: "real estate Casablanca", lang: "english", tone: "listicle" });
 */

class ZunexaTemplateEngine {
  constructor(options = {}) {
    this.bank = null;                       // parsed JSON bank
    this.remotePacks = [];                  // packs merged from a server (optional)
    this.history = new Map();               // anti-repeat memory: key -> Set(usedIds)
    this.maxHistoryPerKey = options.maxHistoryPerKey || 12;
    this.niches = options.niches || null;    // optional custom niche->keywords map
  }

  // ---------- LOADING ----------

  async load(jsonUrl) {
    const res = await fetch(jsonUrl);
    if (!res.ok) throw new Error(`ZunexaTemplateEngine: failed to fetch ${jsonUrl}`);
    this.bank = await res.json();
    return this;
  }

  loadFromObject(obj) {
    this.bank = obj;
    return this;
  }

  /**
   * Pull an additional template pack from your own server/API and merge it
   * into the local bank in memory (does not mutate the original file).
   * Expected pack shape: { languages: { <lang>: { tones: {...}, ctas: {...}, hashtags: {...} } } }
   *
   * This is the hook to make the bank "grow" over time without shipping a
   * bigger JSON file every time — e.g. point it at your own endpoint that
   * stores community-submitted or AI-curated templates.
   */
  async syncFromServer(endpointUrl, { merge = true } = {}) {
    const res = await fetch(endpointUrl);
    if (!res.ok) throw new Error(`ZunexaTemplateEngine: sync failed (${res.status})`);
    const pack = await res.json();
    this.remotePacks.push(pack);
    if (merge) this._mergePack(pack);
    return pack;
  }

  _mergePack(pack) {
    if (!pack || !pack.languages) return;
    for (const [lang, content] of Object.entries(pack.languages)) {
      if (!this.bank.languages[lang]) {
        this.bank.languages[lang] = { tones: {}, ctas: {}, hashtags: {} };
      }
      const target = this.bank.languages[lang];
      // merge tones
      for (const [tone, body] of Object.entries(content.tones || {})) {
        target.tones[tone] = target.tones[tone] || { hooks: [], bodies: [] };
        target.tones[tone].hooks.push(...(body.hooks || []));
        target.tones[tone].bodies.push(...(body.bodies || []));
      }
      // merge ctas
      for (const [cat, arr] of Object.entries(content.ctas || {})) {
        target.ctas[cat] = (target.ctas[cat] || []).concat(arr);
      }
      // merge hashtags
      for (const [niche, arr] of Object.entries(content.hashtags || {})) {
        target.hashtags[niche] = (target.hashtags[niche] || []).concat(arr);
      }
    }
  }

  // ---------- CORE PICKERS (with anti-repetition) ----------

  _pickWithMemory(memoryKey, items) {
    if (!items || items.length === 0) return null;
    if (!this.history.has(memoryKey)) this.history.set(memoryKey, new Set());
    const used = this.history.get(memoryKey);

    let candidates = items
      .map((text, idx) => ({ text, idx }))
      .filter((c) => !used.has(c.idx));

    if (candidates.length === 0) {
      used.clear(); // exhausted variety, reset and start a fresh cycle
      candidates = items.map((text, idx) => ({ text, idx }));
    }

    const choice = candidates[Math.floor(Math.random() * candidates.length)];
    used.add(choice.idx);
    if (used.size > this.maxHistoryPerKey) {
      const first = used.values().next().value;
      used.delete(first);
    }
    return choice.text;
  }

  getHook(lang, tone) {
    const t = this.bank.languages?.[lang]?.tones?.[tone];
    return this._pickWithMemory(`${lang}:${tone}:hook`, t?.hooks);
  }

  getBody(lang, tone) {
    const t = this.bank.languages?.[lang]?.tones?.[tone];
    return this._pickWithMemory(`${lang}:${tone}:body`, t?.bodies);
  }

  getCTA(lang, category = "engagement") {
    const arr = this.bank.languages?.[lang]?.ctas?.[category];
    return this._pickWithMemory(`${lang}:cta:${category}`, arr);
  }

  getHashtags(lang, niche = "business", count = 4) {
    const arr = this.bank.languages?.[lang]?.hashtags?.[niche] || [];
    const shuffled = [...arr].sort(() => Math.random() - 0.5);
    return shuffled.slice(0, count);
  }

  // ---------- NICHE DETECTION (lightweight keyword scoring) ----------

  detectNiche(topic = "") {
    const lower = topic.toLowerCase();
    const map = this.niches || {
      business: ["business", "entrepreneur", "أعمال", "ريادة", "boutique", "vente"],
      marketing: ["marketing", "تسويق", "social media", "content", "ads", "إعلان"],
      fitness: ["fitness", "gym", "رياضة", "صحة", "coach sportif", "workout"],
      beauty: ["beauty", "جمال", "skincare", "makeup", "مكياج"],
      food: ["food", "recipe", "طبخ", "cuisine", "وصفة", "restaurant"],
      coaching: ["coaching", "كوتشينغ", "تطوير", "mindset", "développement"],
    };
    let best = "business";
    let bestScore = 0;
    for (const [niche, keywords] of Object.entries(map)) {
      const score = keywords.reduce((acc, kw) => (lower.includes(kw.toLowerCase()) ? acc + 1 : acc), 0);
      if (score > bestScore) {
        bestScore = score;
        best = niche;
      }
    }
    return best;
  }

  // ---------- HIGH-LEVEL: FULL POST GENERATION ----------

  /**
   * options:
   *   topic (string, required)
   *   lang ("darija"|"franco"|"english"|"french"|"gulf"|"spanish")
   *   tone (optional, defaults to a smart rotation across all available tones)
   *   ctaCategory (optional: "engagement"|"share"|"save"|"comment")
   *   niche (optional, auto-detected from topic if omitted)
   *   hashtagCount (optional, default 4)
   */
  generatePost(options) {
    const {
      topic,
      lang = "darija",
      tone,
      ctaCategory,
      niche,
      hashtagCount = 4,
    } = options;

    if (!this.bank) throw new Error("ZunexaTemplateEngine: call load() first");
    if (!topic) throw new Error("ZunexaTemplateEngine: 'topic' is required");

    const langBank = this.bank.languages[lang];
    if (!langBank) throw new Error(`ZunexaTemplateEngine: unsupported language '${lang}'`);

    const availableTones = Object.keys(langBank.tones);
    const chosenTone = tone && availableTones.includes(tone)
      ? tone
      : availableTones[Math.floor(Math.random() * availableTones.length)];

    const chosenCtaCategory = ctaCategory || ["engagement", "share", "save", "comment"][
      Math.floor(Math.random() * 4)
    ];

    const resolvedNiche = niche || this.detectNiche(topic);

    const hookRaw = this.getHook(lang, chosenTone);
    const bodyRaw = this.getBody(lang, chosenTone);
    const ctaRaw = this.getCTA(lang, chosenCtaCategory);
    const hashtags = this.getHashtags(lang, resolvedNiche, hashtagCount);

    const fill = (str) => (str ? str.replaceAll("{topic}", topic) : "");

    const hook = fill(hookRaw);
    const body = fill(bodyRaw);
    const cta = fill(ctaRaw);

    const text = [hook, "", body, "", cta, "", hashtags.join(" ")]
      .filter((line) => line !== undefined)
      .join("\n")
      .trim();

    return {
      text,
      parts: { hook, body, cta, hashtags },
      meta: { lang, tone: chosenTone, ctaCategory: chosenCtaCategory, niche: resolvedNiche, topic },
    };
  }

  /**
   * Generate several distinct variants in one call (e.g. for an A/B carousel
   * of caption options shown to the user in the dashboard).
   */
  generateVariants(options, count = 3) {
    const variants = [];
    const usedTones = new Set();
    for (let i = 0; i < count; i++) {
      const post = this.generatePost(options);
      variants.push(post);
      usedTones.add(post.meta.tone);
    }
    return variants;
  }
}

// Export for both browser <script> usage and Node/bundlers
if (typeof module !== "undefined" && module.exports) {
  module.exports = ZunexaTemplateEngine;
}
if (typeof window !== "undefined") {
  window.ZunexaTemplateEngine = ZunexaTemplateEngine;
}
