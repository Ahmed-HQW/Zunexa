      "templates_no_name": [
        "لاباس الحمد لله! وراك لاباس؟",
        "هاني مزيان الحمد لله، وراك كيداير؟"
      ]
    },
    {
      "intent": "thanks",
      "lang": "ary",
      "match": ["شكرا", "شكرا بزاف", "الله يعطيك الصحة", "صافي شكرا", "تبارك الله عليك"],
      "templates": [
        "بلا جميل {user_name}! فرحان نعاونك.",
        "ماشي مشكل {user_name}، أنا هنا نعاونك."
      ],
      "templates_no_name": [
        "بلا جميل! فرحان نعاونك.",
        "ماشي مشكل، أنا هنا نعاونك."
      ]
    },
    {
      "intent": "farewell",
      "lang": "ary",
      "match": ["بسلامة", "الله يسلمك", "نتلاقاو", "على الطريق السالامة", "تهلا"],
      "templates": [
        "بسلامة {user_name}! نتلاقاو.",
        "الله يسلمك {user_name}، تهلا."
      ],
      "templates_no_name": [
        "بسلامة! نتلاقاو.",
        "الله يسلمك، تهلا."
      ]
    },
    {
      "intent": "greeting",
      "lang": "fr",
      "match": ["bonjour", "salut", "coucou", "bonsoir", "bonne journee", "bonne journée"],
      "templates": [
        "Salut {user_name} ! Comment ça va ?",
        "Bonjour {user_name} ! Comment puis-je vous aider ?"
      ],
      "templates_no_name": [
        "Salut ! Comment ça va ?",
        "Bonjour ! Comment puis-je vous aider ?"
      ]
    },
    {
      "intent": "wellbeing_check",
      "lang": "fr",
      "match": ["ca va", "ça va", "comment ca va", "comment ça va", "comment allez vous", "comment allez-vous", "tu vas bien"],
      "templates": [
        "Ça va très bien, merci {user_name} ! Et toi ?",
        "Tout va bien {user_name}, et vous ?"
      ],
      "templates_no_name": [
        "Ça va très bien, merci ! Et toi ?",
        "Tout va bien, et vous ?"
      ]
    },
    {
      "intent": "thanks",
      "lang": "fr",
      "match": ["merci", "merci beaucoup", "merci bien", "je vous remercie"],
      "templates": [
        "Avec plaisir, {user_name} !",
        "De rien {user_name}, content de vous aider !"
      ],
      "templates_no_name": [
        "Avec plaisir !",
        "De rien, content de vous aider !"
      ]
    },
    {
      "intent": "farewell",
      "lang": "fr",
      "match": ["au revoir", "a bientot", "à bientôt", "salut a plus", "a plus"],
      "templates": [
        "Au revoir {user_name} ! À bientôt.",
        "À bientôt {user_name}, prenez soin de vous."
      ],
      "templates_no_name": [
        "Au revoir ! À bientôt.",
        "À bientôt, prenez soin de vous."
      ]
    },
    {
      "intent": "greeting",
      "lang": "es",
      "match": ["hola", "buenos dias", "buenos días", "buenas tardes", "buenas noches", "que tal", "qué tal"],
      "templates": [
        "¡Hola, {user_name}! ¿Cómo estás?",
        "¡Hola {user_name}! ¿En qué puedo ayudarte?"
      ],
      "templates_no_name": [
        "¡Hola! ¿Cómo estás?",
        "¡Hola! ¿En qué puedo ayudarte?"
      ]
    },
    {
      "intent": "wellbeing_check",
      "lang": "es",
      "match": ["como estas", "cómo estás", "como te encuentras", "cómo te encuentras", "todo bien"],
      "templates": [
        "¡Muy bien, gracias por preguntar {user_name}! ¿Y tú?",
        "Todo bien por aquí {user_name}, ¿y tú cómo estás?"
      ],
      "templates_no_name": [
        "¡Muy bien, gracias por preguntar! ¿Y tú?",
        "Todo bien por aquí, ¿y tú cómo estás?"
      ]
    },
    {
      "intent": "thanks",
      "lang": "es",
      "match": ["gracias", "muchas gracias", "muchisimas gracias", "muchísimas gracias", "te lo agradezco"],
      "templates": [
        "¡De nada, {user_name}! Un placer ayudarte.",
        "¡Con gusto {user_name}!"
      ],
      "templates_no_name": [
        "¡De nada! Un placer ayudarte.",
        "¡Con gusto!"
      ]
    },
    {
      "intent": "farewell",
      "lang": "es",
      "match": ["adios", "adiós", "hasta luego", "nos vemos", "hasta pronto"],
      "templates": [
        "¡Adiós {user_name}! Hasta luego.",
        "¡Hasta pronto {user_name}, cuídate!"
      ],
      "templates_no_name": [
        "¡Adiós! Hasta luego.",
        "¡Hasta pronto, cuídate!"
      ]
    }
  ]
