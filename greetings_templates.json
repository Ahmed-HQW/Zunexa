{
  "_schema": {
    "version": "1.0.0",
    "placeholder": "{user_name}",
    "fields": {
      "intent": "greeting | farewell | thanks | wellbeing_check",
      "lang": "BCP-47-ish code: en, ar, ary (Moroccan Darija), fr, es",
      "match": "lowercased/trimmed phrases and variants this entry recognizes",
      "templates": "one or more response templates; pick one at random or round-robin",
      "templates_no_name": "used when no {user_name} is available — never show the literal placeholder or invent a name"
    },
    "matching_notes": "Matching must be applied to a normalized, trimmed, lowercased, punctuation-stripped copy of the user's message, and only when that normalized message IS one of the match variants (or differs by trivial repeated letters/diacritics) — not merely contains one as a substring — to avoid classifying normal questions as greetings."
  },
  "entries": [
    {
      "intent": "greeting",
      "lang": "en",
      "match": ["hello", "hi", "hey", "yo", "hiya", "heya", "hi there", "hello there", "good morning", "good afternoon", "good evening", "morning", "evening"],
      "templates": [
        "Hello, {user_name}! How are you?",
        "Hey {user_name}! Good to see you — how can I help?",
        "Hi {user_name}! What can I do for you today?"
      ],
      "templates_no_name": [
        "Hello! How are you?",
        "Hey there! How can I help?",
        "Hi! What can I do for you today?"
      ]
    },
    {
      "intent": "wellbeing_check",
      "lang": "en",
      "match": ["how are you", "how are you doing", "how's it going", "hows it going", "how are things", "whats up", "what's up", "wassup", "sup"],
      "templates": [
        "I'm doing great, thanks for asking, {user_name}! How about you?",
        "All good here, {user_name}! How are you doing?"
      ],
      "templates_no_name": [
        "I'm doing great, thanks for asking! How about you?",
        "All good here! How are you doing?"
      ]
    },
    {
      "intent": "thanks",
      "lang": "en",
      "match": ["thanks", "thank you", "thx", "ty", "thanks a lot", "thank you so much", "much appreciated", "appreciate it"],
      "templates": [
        "You're welcome, {user_name}! Happy to help.",
        "Anytime, {user_name}!"
      ],
      "templates_no_name": [
        "You're welcome! Happy to help.",
        "Anytime!"
      ]
    },
    {
      "intent": "farewell",
      "lang": "en",
      "match": ["bye", "goodbye", "see you", "see ya", "take care", "later", "cya"],
      "templates": [
        "Goodbye, {user_name}! Take care.",
        "See you later, {user_name}!"
      ],
      "templates_no_name": [
        "Goodbye! Take care.",
        "See you later!"
      ]
    },
    {
      "intent": "greeting",
      "lang": "ar",
      "match": ["السلام عليكم", "السلام عليكم ورحمة الله", "وعليكم السلام", "مرحبا", "مرحباً", "أهلا", "أهلاً", "أهلا وسهلا", "أهلاً وسهلاً", "صباح الخير", "مساء الخير"],
      "templates": [
        "وعليكم السلام {user_name}! كيف حالك؟",
        "أهلاً {user_name}! كيف حالك؟",
        "مرحباً بك {user_name}! كيف يمكنني مساعدتك؟"
      ],
      "templates_no_name": [
        "وعليكم السلام! كيف حالك؟",
        "أهلاً بك! كيف حالك؟",
        "مرحباً! كيف يمكنني مساعدتك؟"
      ]
    },
    {
      "intent": "wellbeing_check",
      "lang": "ar",
      "match": ["كيف حالك", "كيف الحال", "شو أخبارك", "ايش أخبارك", "اخبارك ايه"],
      "templates": [
        "أنا بخير، شكراً لسؤالك {user_name}! وأنت كيف حالك؟",
        "الحمد لله بخير {user_name}، كيف حالك أنت؟"
      ],
      "templates_no_name": [
        "أنا بخير، شكراً لسؤالك! وأنت كيف حالك؟",
        "الحمد لله بخير، كيف حالك أنت؟"
      ]
    },
    {
      "intent": "thanks",
      "lang": "ar",
      "match": ["شكرا", "شكراً", "شكرا جزيلا", "شكراً جزيلاً", "جزاك الله خيرا", "جزاك الله خيراً", "يعطيك العافية"],
      "templates": [
        "العفو {user_name}! سعيد بمساعدتك.",
        "لا شكر على واجب {user_name}!"
      ],
      "templates_no_name": [
        "العفو! سعيد بمساعدتك.",
        "لا شكر على واجب!"
      ]
    },
    {
      "intent": "farewell",
      "lang": "ar",
      "match": ["مع السلامة", "إلى اللقاء", "الى اللقاء", "وداعا", "وداعاً", "نراك لاحقا"],
      "templates": [
        "مع السلامة {user_name}! إلى اللقاء.",
        "إلى اللقاء {user_name}، اعتن بنفسك."
      ],
      "templates_no_name": [
        "مع السلامة! إلى اللقاء.",
        "إلى اللقاء، اعتن بنفسك."
      ]
    },
    {
      "intent": "greeting",
      "lang": "ary",
      "match": ["سلام", "سلام عليكم", "سلام عليكم ورحمة الله", "اهلين", "أهلين", "صباح النور", "صباح الخير", "مساء النور", "مساء الخير"],
      "templates": [
        "سلام {user_name}! كيداير؟",
        "أهلين {user_name}! كيدايرة؟",
        "سلام عليكم {user_name}! لاباس عليك؟"
      ],
      "templates_no_name": [
        "سلام! كيداير؟",
        "أهلين! كيدايرة؟",
        "سلام عليكم! لاباس؟"
      ]
    },
    {
      "intent": "wellbeing_check",
      "lang": "ary",
      "match": ["كيداير", "كيداير راك", "كيدايرة", "كيدايرة راكي", "لاباس", "لاباس عليك", "لاباس عليكم", "واش لاباس", "اخبارك", "اش خبارك", "كي راك"],
      "templates": [
        "لاباس الحمد لله {user_name}! وراك لاباس؟",
        "هاني مزيان الحمد لله {user_name}، وراك كيداير؟"
